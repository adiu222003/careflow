# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/careflow

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=60

# ─── Google OAuth token encryption (Fernet) ─────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ─── AI / Gemini ─────────────────────────────────────────────────────────────
ENABLE_LLM=true
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.0-flash

# ─── Email / Resend ──────────────────────────────────────────────────────────
ENABLE_EMAIL=true
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@careflow.demo

# ─── Google Calendar ─────────────────────────────────────────────────────────
ENABLE_GOOGLE_CALENDAR=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events

# ─── Internal scheduler protection ──────────────────────────────────────────
INTERNAL_JOB_SECRET=change-me-to-a-long-random-string

# ─── CORS / URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
